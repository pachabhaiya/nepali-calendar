{
  "name": "pachabhaiya/nepali-calendar",
  "description": "Nepali calendar PHP library",
  "type": "library",
  "keywords": [
    "nepali",
    "calendar",
    "library"
  ],
  "homepage": "https://github.com/pachabhaiya/nepali-calendar",
  "license": "MIT",
  "authors": [
    {
      "name": "Chhabi Pachabhaiya",
      "email": "chhabi@pachabhaiya.com"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "NepaliCalendar\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NepaliCalendar\\Tests\\": "tests/src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
